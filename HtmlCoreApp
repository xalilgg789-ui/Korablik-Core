  function hashCode(str){
    var h = 0;
    for(var i=0;i<str.length;i++){
      h = ((h << 5) - h) + str.charCodeAt(i);
      h = h & h;
    }
    return Math.abs(h).toString(36).toUpperCase();
  }
  function makeCode(type, value){
    var ts = Date.now().toString(36).toUpperCase();
    var data = type + ':' + value + ':' + ts;
    var sig = hashCode(data + SECRET).substr(0, 6);
    return type + '-' + value + '-' + ts + '-' + sig;
  }
  function parseCode(code){
    var parts = code.split('-');
    if(parts.length !== 4) return null;
    var type = parts[0], value = parts[1], ts = parts[2], sig = parts[3];
    var data = type + ':' + value + ':' + ts;
    var check = hashCode(data + SECRET).substr(0, 6);
    if(check !== sig) return null;
    var created = parseInt(ts, 36);
    if(Date.now() - created > 24*60*60*1000) return null;
    return { type: type, value: value };
  }
