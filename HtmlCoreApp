var fxCanvas = document.getElementById('fxCanvas');
var fx = fxCanvas.getContext('2d');
var fxType = 'none';
var fxItems = [];
var fxLast = 0;
var FX_INTERVAL = 1000/60;

function resizeFx(){
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  fxCanvas.width = window.innerWidth * dpr;
  fxCanvas.height = window.innerHeight * dpr;
  fxCanvas.style.width = window.innerWidth + 'px';
  fxCanvas.style.height = window.innerHeight + 'px';
  fx.setTransform(dpr,0,0,dpr,0,0);
  initFxItems();
}
window.addEventListener('resize', resizeFx);

function makeBin(n){
  var s = '';
  for(var i=0;i<n;i++) s += (Math.random()>0.5 ? '1' : '0');
  return s;
}

function pickRandomArt(){
  var r = Math.random();
  if(r < 0.33) return ART_POPA;
  if(r < 0.66) return ART_SISKI;
  return ART_NEW;
}

function initFxItems(){
  var W = window.innerWidth, H = window.innerHeight;
  fxItems = [];
  if(fxType === 'sakura'){
    var n = Math.min(28, Math.floor(W/16));
    for(var i=0;i<n;i++){
      fxItems.push({x:Math.random()*W,y:Math.random()*H,s:6+Math.random()*6,vy:0.5+Math.random()*0.9,vx:-0.4+Math.random()*0.8,rot:Math.random()*Math.PI*2,vr:-0.03+Math.random()*0.06,sway:Math.random()*Math.PI*2,swayS:0.02+Math.random()*0.02});
    }
  } else if(fxType === 'snow'){
    var n2 = Math.min(70, Math.floor(W/8));
    for(var j=0;j<n2;j++){
      fxItems.push({x:Math.random()*W,y:Math.random()*H,r:0.6+Math.random()*1.8,vy:0.4+Math.random()*1.2,vx:-0.3+Math.random()*0.6,sway:Math.random()*Math.PI*2,swayS:0.01+Math.random()*0.02});
    }
  } else if(fxType === 'hacker'){
    var cols = Math.floor(W/14);
    for(var c=0;c<cols;c++){
      fxItems.push({x:c*14,y:Math.random()*H-H,speed:2+Math.random()*4,chars:makeBin(8+Math.floor(Math.random()*10))});
    }
  } else if(fxType === 'ph'){
    for(var p=0;p<5;p++){
      var art = pickRandomArt();
      var artW = art[0].length;
      var isNew = (art === ART_NEW);
      var maxW = isNew ? W * 0.45 : W * 0.7;
      var size = Math.floor((maxW / artW) * 10) / 10;
      var maxSize = isNew ? 3.5 : 11;
      var minSize = isNew ? 1.2 : 5;
      if(size > maxSize) size = maxSize;
      if(size < minSize) size = minSize;
      fxItems.push({
        art: art, x: Math.random()*(W - artW*size*0.6),
        y: -Math.random()*H - 400, speed: 0.5 + Math.random()*1.0,
        size: size, sway: Math.random()*Math.PI*2,
        swayS: 0.008 + Math.random()*0.012
      });
    }
  }
}

function drawFx(){
  var W = window.innerWidth, H = window.innerHeight;
  fx.clearRect(0,0,W,H);

  if(fxType === 'sakura'){
    for(var i=0;i<fxItems.length;i++){
      var p = fxItems[i];
      p.sway += p.swayS;
      p.x += p.vx + Math.sin(p.sway)*0.5;
      p.y += p.vy;
      p.rot += p.vr;
      if(p.y > H+20){p.y=-20;p.x=Math.random()*W}
      if(p.x < -20) p.x = W+20;
      if(p.x > W+20) p.x = -20;
      fx.save();fx.translate(p.x,p.y);fx.rotate(p.rot);
      fx.fillStyle='rgba(255,158,196,0.75)';
      fx.beginPath();fx.ellipse(0,0,p.s*0.5,p.s,0,0,Math.PI*2);fx.fill();
      fx.fillStyle='rgba(255,200,220,0.5)';
      fx.beginPath();fx.ellipse(p.s*0.3,p.s*0.3,p.s*0.3,p.s*0.6,0,0,Math.PI*2);fx.fill();
      fx.restore();
    }
  } else if(fxType === 'snow'){
    fx.fillStyle='rgba(10,20,32,0.35)';fx.fillRect(0,0,W,H);
    var groundY = H - 40;
    fx.fillStyle='rgba(6,12,20,0.85)';
    fx.beginPath();fx.moveTo(0,H);fx.lineTo(0,groundY);
    for(var x=0;x<=W;x+=40){
      var h = 30 + Math.sin(x*0.05)*20;
      fx.lineTo(x+20,groundY-h);fx.lineTo(x+40,groundY);
    }
    fx.lineTo(W,H);fx.closePath();fx.fill();
    for(var j=0;j<fxItems.length;j++){
      var s = fxItems[j];
      s.sway += s.swayS;
      s.x += s.vx + Math.sin(s.sway)*0.3;
      s.y += s.vy;
      if(s.y > H+10){s.y=-10;s.x=Math.random()*W}
      if(s.x < -10) s.x = W+10;
      if(s.x > W+10) s.x = -10;
      fx.fillStyle='rgba(220,240,255,0.85)';
      fx.beginPath();fx.arc(s.x,s.y,s.r,0,Math.PI*2);fx.fill();
    }
  } else if(fxType === 'hacker'){
    fx.fillStyle='rgba(0,0,0,0.15)';fx.fillRect(0,0,W,H);
    fx.font='13px monospace';
    for(var k=0;k<fxItems.length;k++){
      var c = fxItems[k];
      c.y += c.speed;
      if(Math.random()<0.04) c.chars = makeBin(c.chars.length);
      if(c.y > H+200){c.y=-Math.random()*H;c.speed=2+Math.random()*4}
      for(var q=0;q<c.chars.length;q++){
        var alpha = 1 - q/c.chars.length;
        fx.fillStyle='rgba(34,255,102,'+(alpha*0.9)+')';
        fx.fillText(c.chars[q],c.x,c.y-q*14);
      }
    }
  } else if(fxType === 'ph'){
    for(var m=0;m<fxItems.length;m++){
      var it = fxItems[m];
      it.sway += it.swayS;
      it.y += it.speed;
      it.x += Math.sin(it.sway)*0.3;
      if(it.y > H + 400){
        it.y = -Math.random()*H - 400;
        it.x = Math.random()*(W - it.art[0].length*it.size*0.6);
        it.art = pickRandomArt();
      }
      fx.save();
      fx.shadowColor = 'rgba(255,140,0,0.9)';
      fx.shadowBlur = 8;
      fx.font = it.size + 'px monospace';
      fx.fillStyle = 'rgba(255,160,20,0.95)';
      fx.textBaseline = 'top';
      for(var r=0;r<it.art.length;r++){
        fx.fillText(it.art[r], it.x, it.y + r*it.size);
      }
      fx.restore();
    }
  }
}

function fxLoop(ts){
  requestAnimationFrame(fxLoop);
  if(!fxLast) fxLast = ts;
  var dt = ts - fxLast;
  if(dt >= FX_INTERVAL){
    fxLast = ts - (dt % FX_INTERVAL);
    if(fxType !== 'none') drawFx();
    else fx.clearRect(0,0,window.innerWidth,window.innerHeight);
  }
}

