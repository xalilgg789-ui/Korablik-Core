function buyItem(item){
  if(!currentUser) return;
  var p = getProfile(currentUser.login);
  if(p.owned.indexOf(item.id) >= 0){
    p.activeEmoji = item.emoji;
    saveProfiles(); renderProfile(); renderShop(); updateUserUI();
    toast('Выбран: ' + item.emoji);
    return;
  }
  if(p.stars < item.price){ toast('Не хватает звёзд'); return; }
  p.stars -= item.price;
  p.owned.push(item.id);
  p.activeEmoji = item.emoji;
  saveProfiles(); renderProfile(); renderShop(); updateUserUI();
  toast('Куплено: ' + item.emoji + ' за ' + item.price + '★');
}

