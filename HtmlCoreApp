}
function isAdmin(login){ return login === ADMIN_LOGIN; }

function register(login, pass){
  if(!login || !pass) return { ok:false, msg:'Заполни все поля' };
  if(login.length < 3) return { ok:false, msg:'Логин минимум 3 символа' };
  if(pass.length < 6) return { ok:false, msg:'Пароль минимум 6 символов' };
  if(isAdmin(login)) return { ok:false, msg:'Этот логин занят' };
  if(users.find(function(u){ return u.login.toLowerCase() === login.toLowerCase(); }))
    return { ok:false, msg:'Логин уже занят' };
  var user = { login: login, pass: pass, admin: false, created: Date.now() };
  users.push(user); saveUsers();
  getProfile(login); saveProfiles();
  return { ok:true, user:user };
}

function login(login, pass){
  if(!login || !pass) return { ok:false, msg:'Заполни все поля' };
  if(login === ADMIN_LOGIN && pass === ADMIN_PASS){
    return { ok:true, user: { login: ADMIN_LOGIN, pass: ADMIN_PASS, admin:true } };
  }
  var u = users.find(function(x){ return x.login === login && x.pass === pass; });
  if(u) return { ok:true, user:u };
  return { ok:false, msg:'Неверный логин или пароль' };
}

