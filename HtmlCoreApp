<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Конструктор</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
--bg:#0a0a0a;--card:#141414;--card2:#1c1c1c;
--line:#2a2a2a;--accent:#e8e8e8;--accent2:#ffffff;
--txt:#f0f0f0;--mut:#7a7a7a;--red:#ef4444;--r:22px;
--gold:#fbbf24;--blue:#3b82f6;
}
html,body{height:100%;overflow:hidden}
body{
background:var(--bg);color:var(--txt);
font-family:system-ui,-apple-system,sans-serif;
overflow-x:hidden;overscroll-behavior:none;
transition:background .4s,color .4s;
}
#fx{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
#fx canvas{display:block;width:100%;height:100%}
#tapLayer{position:fixed;inset:0;z-index:3;background:transparent;display:none}
#tapLayer.on{display:block}
.page{position:fixed;inset:0;padding:14px;padding-bottom:130px;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;z-index:1;opacity:0;visibility:hidden;transform:translateY(14px);transition:opacity .28s ease,transform .28s ease,visibility .28s}
.page.active{opacity:1;visibility:visible;transform:translateY(0)}
.top{display:flex;gap:12px;margin-bottom:14px;align-items:stretch}
.ava{width:74px;height:74px;border-radius:50%;background:linear-gradient(135deg,#444,#888);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:#fff;flex-shrink:0;overflow:hidden;cursor:pointer;border:2px solid var(--line);transition:transform .15s}
.ava:active{transform:scale(.94)}
.ava img{width:100%;height:100%;object-fit:cover;display:none}
.ava.has img{display:block}
.ava.has span{display:none}
.nick{flex:1;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;display:flex;flex-direction:column;justify-content:center;cursor:pointer;min-width:0}
.nick-line{display:flex;align-items:center;gap:6px}
.nick-name{font-size:17px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nick-sub{font-size:12px;color:var(--mut);margin-top:4px}
.nick-emoji{font-size:16px;margin-left:2px}
.verified{width:18px;height:18px;flex-shrink:0;background:var(--blue);border-radius:50%;display:inline-flex;align-items:center;justify-content:center}
.verified::before{content:'';width:7px;height:4px;border-left:1.8px solid #fff;border-bottom:1.8px solid #fff;transform:rotate(-45deg) translate(0.5px,-1px)}
.box{position:relative;display:flex;align-items:center;justify-content:center;text-align:center;background:var(--card);border:1px solid var(--line);border-radius:var(--r);color:var(--txt);font-size:17px;font-weight:600;cursor:pointer;overflow:hidden;user-select:none;padding:20px 14px;transition:background .3s,border-color .3s,transform .08s,box-shadow .3s}
.box:active{transform:scale(.985)}
.box.pur{background:linear-gradient(135deg,#3a3a3a,#111);border-color:#555;color:#fff}
.box.grn{background:linear-gradient(135deg,#2a2a2a,#0d0d0d);border-color:#555;color:#fff}
.box:disabled{opacity:.35;pointer-events:none;filter:grayscale(.7)}
.box .sub{display:block;font-size:12px;font-weight:400;margin-top:7px;color:var(--mut)}
.box.pur .sub,.box.grn .sub{color:rgba(255,255,255,.7)}
.box.ready{box-shadow:0 0 0 2px var(--accent) inset,0 0 0 18px rgba(255,255,255,.15);border-color:var(--accent)}
.create{width:100%;margin-bottom:14px;min-height:82px;flex-direction:column}
.grid{display:grid;grid-template-columns:1fr 1.05fr;gap:12px;margin-top:24px}
.saves-col{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:12px;display:flex;flex-direction:column;min-height:300px;max-height:52vh}
.saves-title{font-size:11px;color:var(--mut);letter-spacing:.8px;text-transform:uppercase;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.saves-title b{background:var(--card2);border:1px solid var(--line);border-radius:8px;padding:1px 8px;font-size:10px;font-weight:600}
.saves-list{flex:1;display:flex;flex-direction:column;gap:7px;overflow-y:auto;padding-right:3px;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:var(--line) transparent}
.saves-list::-webkit-scrollbar{width:3px}
.saves-list::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}
.row{display:flex;align-items:center;gap:8px;padding:8px 9px;background:var(--card2);border:1px solid var(--line);border-radius:12px;cursor:pointer;flex-shrink:0;transition:border-color .2s,background .2s;position:relative;overflow:hidden}
.row.sel{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset;background:#222}
.row-ico{width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;flex-shrink:0;background:#ffffff18;color:#ddd}
.row-name{flex:1;min-width:0;font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row-del{width:24px;height:24px;flex-shrink:0;border-radius:7px;border:none;background:transparent;color:var(--red);font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;opacity:.7;transition:opacity .15s,background .15s}
.row-del:active{opacity:1;background:#ef444422}
.empty{color:var(--mut);font-size:11px;text-align:center;padding:20px 6px;line-height:1.6}
.actions{display:flex;flex-direction:column;gap:12px}
.settings-list{max-width:520px;margin:0 auto}
.set-item{display:flex;align-items:center;gap:14px;padding:16px 14px;background:var(--card);border:1px solid var(--line);border-radius:16px;margin-bottom:10px;cursor:pointer;position:relative;overflow:hidden;transition:border-color .2s,background .3s,transform .08s}
.set-item:active{transform:scale(.99)}
.set-ico{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#ffffff12}
.set-ico svg{width:22px;height:22px;stroke:var(--accent2);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.set-body{flex:1;min-width:0}
.set-name{font-size:16px;font-weight:600;margin-bottom:3px}
.set-desc{font-size:12px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.set-arrow{color:var(--mut);font-size:18px;flex-shrink:0}
.subpage{position:fixed;inset:0;padding:14px;padding-bottom:130px;overflow-y:auto;z-index:2;background:var(--bg);opacity:0;visibility:hidden;transform:translateX(30px);transition:opacity .25s,transform .25s,visibility .25s}
.subpage.active{opacity:1;visibility:visible;transform:translateX(0)}
.sub-head{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.sub-back{width:42px;height:42px;border-radius:12px;background:var(--card);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;position:relative;overflow:hidden;transition:transform .08s}
.sub-back:active{transform:scale(.94)}
.sub-back svg{width:20px;height:20px;stroke:var(--txt);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.sub-title{font-size:20px;font-weight:700}
.section-card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:10px;display:flex;align-items:center;gap:14px;cursor:pointer;position:relative;overflow:hidden;transition:border-color .2s,background .3s,transform .08s}
.section-card:active{transform:scale(.99)}
.section-ico{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#ffffff12;font-size:20px;font-weight:700;color:var(--accent2)}
.section-body{flex:1;min-width:0}
.section-name{font-size:16px;font-weight:600;margin-bottom:3px}
.section-desc{font-size:12px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.section-arrow{color:var(--mut);font-size:18px;flex-shrink:0}
.theme-card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:14px;cursor:pointer;position:relative;overflow:hidden;transition:border-color .2s,background .3s,transform .08s}
.theme-card:active{transform:scale(.99)}
.theme-card.sel{border-color:var(--accent);box-shadow:0 0 0 1.5px var(--accent) inset}
.theme-prev{width:54px;height:54px;border-radius:14px;flex-shrink:0;overflow:hidden;position:relative;border:1px solid var(--line)}
.theme-prev canvas{width:100%;height:100%;display:block}
.theme-body{flex:1;min-width:0}
.theme-name{font-size:15px;font-weight:600;margin-bottom:3px}
.theme-desc{font-size:12px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.theme-check{width:22px;height:22px;border-radius:50%;border:2px solid var(--line);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s}
.theme-card.sel .theme-check{background:var(--accent);border-color:var(--accent)}
.theme-check::after{content:'';width:9px;height:9px;border-radius:50%;background:var(--bg);transform:scale(0);transition:transform .2s}
.theme-card.sel .theme-check::after{transform:scale(1)}
.page-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:60vh;text-align:center;color:var(--mut)}
.page-empty .big{font-size:44px;margin-bottom:12px;opacity:.5}
.page-empty .t{font-size:17px;color:var(--txt);margin-bottom:6px;font-weight:600}
.page-empty .d{font-size:13px}
.navbar{position:fixed;bottom:14px;left:14px;right:14px;background:rgba(20,20,20,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:26px;padding:8px 6px;display:flex;justify-content:space-around;align-items:center;z-index:500;box-shadow:0 8px 28px rgba(0,0,0,.5)}
.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:8px 4px;border-radius:20px;cursor:pointer;position:relative;overflow:hidden;transition:background .25s,transform .08s;user-select:none}
.nav-item:active{transform:scale(.94)}
.nav-item.active{background:linear-gradient(135deg,rgba(255,255,255,.14),rgba(255,255,255,.05))}
.nav-ico{width:24px;height:24px;display:flex;align-items:center;justify-content:center;color:var(--mut);transition:color .25s,transform .25s}
.nav-ico svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.nav-item.active .nav-ico{color:var(--accent2);transform:scale(1.08)}
.nav-label{font-size:10px;font-weight:600;color:var(--mut);letter-spacing:.2px;transition:color .25s}
.nav-item.active .nav-label{color:#fff}
.rip{position:absolute;border-radius:50%;transform:translate(-50%,-50%) scale(0);pointer-events:none;animation:rip .6s ease-out forwards;will-change:transform,opacity}
.rip::before{content:'';position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.5) 0%,rgba(255,255,255,.2) 45%,transparent 70%)}
.rip::after{content:'';position:absolute;inset:18%;border-radius:50%;border:1.5px solid rgba(255,255,255,.45);animation:ripRing .6s ease-out forwards}
@keyframes rip{0%{transform:translate(-50%,-50%) scale(0);opacity:1}100%{transform:translate(-50%,-50%) scale(2.4);opacity:0}}
@keyframes ripRing{0%{transform:scale(.4);opacity:.9}100%{transform:scale(1.6);opacity:0}}
.toast{position:fixed;bottom:110px;left:50%;transform:translateX(-50%) translateY(30px);background:var(--card);color:#fff;border:1px solid var(--line);padding:11px 22px;border-radius:24px;font-size:13px;opacity:0;pointer-events:none;transition:.25s;box-shadow:0 8px 24px rgba(0,0,0,.5);z-index:999;white-space:nowrap;max-width:90vw;overflow:hidden;text-overflow:ellipsis}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;padding:24px;z-index:1000;backdrop-filter:blur(4px)}
.ov.on{display:flex}
.mod{width:100%;max-width:330px;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px}
.mod h3{font-size:16px;margin-bottom:14px}
.mod input{width:100%;padding:12px 14px;background:var(--bg);border:1px solid var(--line);border-radius:12px;color:var(--txt);font-size:15px;outline:none;margin-bottom:14px}
.mod input:focus{border-color:var(--accent)}
.mod-btns{display:flex;gap:10px}
.mod-btns button{flex:1;padding:12px;border-radius:12px;border:none;font-size:14px;font-weight:600;cursor:pointer}
.ok{background:var(--accent);color:#000}
.no{background:var(--card2);color:var(--mut)}
.ph-hint{position:fixed;bottom:100px;left:14px;right:14px;z-index:400;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s;text-align:center;pointer-events:none}
.ph-hint.on{opacity:1;visibility:visible;pointer-events:auto}
.ph-hint-text{font-size:12px;color:var(--mut);line-height:1.5;margin-bottom:8px;font-style:italic}
.ph-hint-copy{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:12px;color:var(--accent);cursor:pointer;position:relative;overflow:hidden;transition:transform .08s,background .2s}
.ph-hint-copy:active{transform:scale(.95)}
.ph-reset{position:fixed;bottom:100px;left:14px;width:26px;height:26px;border-radius:50%;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.35);color:rgba(239,68,68,.6);font-size:13px;display:none;align-items:center;justify-content:center;cursor:pointer;z-index:401;transition:opacity .2s,transform .08s}
.ph-reset.on{display:flex}
.ph-reset:active{transform:scale(.9);background:rgba(239,68,68,.3)}
.art-view{position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.96);display:none;flex-direction:column;backdrop-filter:blur(6px)}
.art-view.on{display:flex}
.art-top{display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line);background:var(--card)}
.art-dot{width:12px;height:12px;border-radius:50%;background:var(--accent);margin-right:8px;flex-shrink:0}
.art-tab-title{flex:1;font-size:13px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.art-close{width:38px;height:38px;border-radius:12px;background:var(--card2);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--txt);font-size:18px;cursor:pointer;flex-shrink:0}
.art-close:active{transform:scale(.94)}
.art-body{flex:1;display:flex;align-items:center;justify-content:center;padding:18px;overflow:auto}
.art-body pre{font-family:monospace;font-size:11px;line-height:1.08;color:#ff8c00;text-shadow:0 0 14px rgba(255,140,0,.55);white-space:pre}
.art-bottom{padding:14px 16px 20px;border-top:1px solid var(--line);background:var(--card)}
.art-hint-text{font-size:12px;color:var(--mut);line-height:1.5;margin-bottom:10px;font-style:italic}
.art-copy{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:13px;background:var(--card2);border:1px solid var(--line);border-radius:14px;color:var(--accent);font-size:14px;font-weight:600;cursor:pointer;position:relative;overflow:hidden;transition:transform .08s,background .2s}
.art-copy:active{transform:scale(.97)}
.kiss{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%) scale(0);font-size:80px;z-index:3000;pointer-events:none;opacity:0}
.kiss.go{animation:kissAnim 1.8s ease-out forwards}
@keyframes kissAnim{0%{transform:translate(-50%,-50%) scale(0) rotate(-20deg);opacity:0}20%{transform:translate(-50%,-50%) scale(1.3) rotate(10deg);opacity:1}50%{transform:translate(-50%,-50%) scale(1) rotate(0);opacity:1}100%{transform:translate(-50%,-120%) scale(0.6) rotate(15deg);opacity:0}}
.text-view{position:fixed;inset:0;z-index:2;background:var(--bg);padding:14px;padding-bottom:130px;display:none;flex-direction:column;overflow:hidden}
.text-view.on{display:flex}
.text-textarea{flex:1;width:100%;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;color:var(--txt);font-family:monospace;font-size:12px;line-height:1.4;resize:none;outline:none;margin-bottom:12px}
.text-textarea:focus{border-color:var(--accent)}
.text-save{padding:15px;background:var(--accent);color:#000;border:none;border-radius:14px;font-size:15px;font-weight:700;cursor:pointer;position:relative;overflow:hidden;transition:transform .08s}
.text-save:active{transform:scale(.97)}
.auth{position:fixed;inset:0;z-index:5000;background:var(--bg);display:none;flex-direction:column;padding:30px 24px;overflow-y:auto}
.auth.on{display:flex}
.auth-logo{width:96px;height:96px;border-radius:50%;background:linear-gradient(135deg,#7c3aed,#3b82f6);display:flex;align-items:center;justify-content:center;font-size:40px;font-weight:700;color:#fff;margin:40px auto 24px;box-shadow:0 12px 40px rgba(124,58,237,.35)}
.auth-title{font-size:26px;font-weight:700;text-align:center;margin-bottom:8px}
.auth-sub{font-size:14px;color:var(--mut);text-align:center;margin-bottom:36px;line-height:1.5}
.auth-field{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:4px 4px;margin-bottom:12px;display:flex;align-items:center;transition:border-color .2s}
.auth-field:focus-within{border-color:var(--accent)}
.auth-field input{flex:1;background:transparent;border:none;padding:14px 16px;color:var(--txt);font-size:15px;outline:none;font-family:inherit}
.auth-field input::placeholder{color:var(--mut)}
.auth-btn{width:100%;padding:16px;border:none;border-radius:14px;font-size:15px;font-weight:700;cursor:pointer;margin-top:6px;position:relative;overflow:hidden;transition:transform .08s,background .2s}
.auth-btn:active{transform:scale(.98)}
.auth-btn.main{background:#3b82f6;color:#fff}
.auth-btn.guest{background:transparent;border:1px solid var(--line);color:var(--mut);margin-top:20px;font-weight:500}
.auth-switch{text-align:center;font-size:13px;color:var(--mut);margin-top:20px}
.auth-switch a{color:#3b82f6;text-decoration:none;cursor:pointer;font-weight:600}
.profile-view{position:fixed;inset:0;z-index:2;background:var(--bg);padding:14px;padding-bottom:130px;display:none;flex-direction:column;overflow-y:auto}
.profile-view.on{display:flex}
.profile-head{display:flex;flex-direction:column;align-items:center;padding:30px 20px 20px}
.profile-ava{width:96px;height:96px;border-radius:50%;background:linear-gradient(135deg,#444,#888);display:flex;align-items:center;justify-content:center;font-size:40px;font-weight:700;color:#fff;overflow:hidden;cursor:pointer;border:3px solid var(--line);margin-bottom:16px;position:relative}
.profile-ava img{width:100%;height:100%;object-fit:cover;display:none}
.profile-ava.has img{display:block}
.profile-ava.has span{display:none}
.profile-ava::after{content:'✎';position:absolute;bottom:0;right:0;width:32px;height:32px;border-radius:50%;background:#3b82f6;color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;border:3px solid var(--bg)}
.profile-name{font-size:22px;font-weight:700;display:flex;align-items:center;gap:8px;margin-bottom:6px}
.profile-emoji{font-size:22px}
.profile-sub{font-size:13px;color:var(--mut);margin-bottom:6px}
.profile-stars{font-size:14px;color:var(--gold);font-weight:600;margin-bottom:6px}
.profile-lvl{font-size:12px;color:var(--mut);padding:4px 12px;background:var(--card);border:1px solid var(--line);border-radius:10px}
.profile-info{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin-top:20px}
.profile-info-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.profile-info-row:last-child{border-bottom:none}
.profile-info-label{font-size:13px;color:var(--mut)}
.profile-info-value{font-size:14px;font-weight:600}
.profile-logout{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#ef4444;padding:14px;border-radius:14px;font-size:15px;font-weight:600;cursor:pointer;margin-top:20px;position:relative;overflow:hidden;text-align:center;transition:transform .08s}
.profile-logout:active{transform:scale(.98)}
.shop-title{font-size:16px;font-weight:700;margin:20px 0 12px;display:flex;justify-content:space-between;align-items:center}
.shop-title .price{font-size:13px;color:var(--gold)}
.shop-item{display:flex;align-items:center;gap:14px;padding:14px;background:var(--card);border:1px solid var(--line);border-radius:16px;margin-bottom:10px;cursor:pointer;position:relative;overflow:hidden;transition:border-color .2s,transform .08s}
.shop-item:active{transform:scale(.99)}
.shop-item.owned{border-color:var(--gold)}
.shop-emoji{font-size:30px;flex-shrink:0;width:44px;text-align:center}
.shop-body{flex:1;min-width:0}
.shop-name{font-size:15px;font-weight:600;margin-bottom:3px}
.shop-tier{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.5px}
.shop-price{font-size:13px;color:var(--gold);font-weight:600;flex-shrink:0}
.shop-owned{font-size:11px;color:var(--gold);background:rgba(251,191,36,.12);padding:4px 10px;border-radius:8px;flex-shrink:0}
.stars-view{position:fixed;inset:0;z-index:2;background:var(--bg);padding:14px;padding-bottom:130px;display:none;flex-direction:column;overflow-y:auto}
.stars-view.on{display:flex}
.stars-head{text-align:center;padding:20px 0}
